{
    "name": "autocode-react-template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "start": "vite --open",
        "build": "echo \"Dummy build script required for Autocode Compile\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "npm run test:junit",
        "test:local": "jest --reporters=default",
        "test:watch": "jest --watchAll --reporters=default",
        "test:junit": "jest --reporters=jest-junit",
        "test:xunit": "jest",
        "prepare": "husky"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.11.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-redux": "^9.2.0",
        "react-router-dom": "^7.9.6"
    },
    "devDependencies": {
        "@babel/core": "^7.24.4",
        "@babel/preset-env": "^7.24.4",
        "@babel/preset-react": "^7.24.1",
        "@babel/preset-typescript": "^7.24.1",
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^6.4.2",
        "@testing-library/react": "^15.0.1",
        "@testing-library/user-event": "^14.5.2",
        "@types/jest": "^29.5.12",
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.2.22",
        "@typescript-eslint/parser": "^8.65.0",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "hex-rgb": "^5.0.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^30.0.0-beta.3",
        "jest-junit": "^16.0.0",
        "jest-transform-css": "^6.0.3",
        "jest-transform-stub": "^2.0.0",
        "lint-staged": "^17.2.0",
        "prettier": "^3.9.6",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.65.0",
        "vite": "^5.2.0"
    },
    "jest-junit": {
        "suiteName": "junit test results",
        "outputDirectory": ".",
        "outputName": "junit.xml"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md,html}": "prettier --write"
    }
}
